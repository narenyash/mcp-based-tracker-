# Copy to apps/server/.env (git-ignored). Every key the server reads is listed here; see docs/DEPLOY.md.
# In containers / hosting platforms set these as real environment variables instead (they take priority).
#
# Database + AWS are read from the shared apps/.env (only these keys are taken from it):
#   MONGODB_DIRECT_URI (or MONGODB_URI), MONGODB_DB_NAME,
#   AWS_REGION, AWS_BUCKET_NAME, AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, S3_UPLOAD_PREFIX
# All TeamTrack collections are prefixed (tt_users, tt_projects, ...) so the database can be shared.

# ---- runtime
NODE_ENV=development
PORT=4000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=debug
# Exact origin of the web app (CORS + links in emails). Production: https://teamtrack.example.com
CLIENT_URL=http://localhost:5173
# Number of reverse proxies in front of the API (1 = nginx). Wrong values break per-IP rate limits.
TRUST_PROXY=0
# Hard deadline for graceful shutdown (ms); keep it below your orchestrator's kill grace period.
# SHUTDOWN_TIMEOUT_MS=10000

# ---- database
# Optional: a dedicated database instead of the shared one (overrides MONGODB_*). Must be a replica set.
# MONGO_URI=mongodb://localhost:27017/teamtrack?replicaSet=rs0&directConnection=true
# MONGO_DB_NAME=teamtrack
# Shared keys (normally in apps/.env):
# MONGODB_DIRECT_URI=mongodb://...
# MONGODB_URI=mongodb+srv://user:<password>@cluster0.example.mongodb.net/?retryWrites=true&w=majority
# MONGODB_DB_NAME=wmsnk
# COLLECTION_PREFIX=tt_

# ---- auth
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Keep this separate from other apps' JWT secrets. Also signs memory-storage download links.
JWT_ACCESS_SECRET=
JWT_ACCESS_KID=k1
# Old keys still accepted for verification during rotation: "kid:secret,kid:secret"
JWT_PREVIOUS_KEYS=
JWT_ACCESS_TTL_SEC=900
REFRESH_TTL_DAYS=7

# true = anyone can create a new workspace from the sign-up page; false = invite-only.
ALLOW_WORKSPACE_SIGNUP=true
# Never disable in production (the test suite sets false).
RATE_LIMIT_ENABLED=true

# ---- email
# json = print emails to the server log; smtp = send for real (Gmail app password, AWS SES SMTP, Mailpit...)
MAIL_TRANSPORT=json
# Mailpit (docker compose up -d): SMTP_HOST=localhost SMTP_PORT=1025, inbox at http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=TeamTrack <no-reply@teamtrack.local>
#
# Gmail example (SMTP_PASS is a 16-character app password, NOT the account password:
# Google Account > Security > 2-Step Verification > App passwords):
# MAIL_TRANSPORT=smtp
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=you@gmail.com
# SMTP_PASS=xxxxxxxxxxxxxxxx
# MAIL_FROM=TeamTrack <you@gmail.com>
#
# AWS SES SMTP example (SMTP credentials from the SES console, not IAM access keys):
# SMTP_HOST=email-smtp.ap-south-1.amazonaws.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=AKIA...
# SMTP_PASS=<ses-smtp-password>
#
# Dev/staging only (rejected when NODE_ENV=production): deliver every email to this one inbox,
# with the real recipient shown in the subject.
# MAIL_REDIRECT_TO=you@example.com

# ---- file storage (uploads go through the API; downloads use short-lived signed URLs)
# s3 | memory. Default: s3 when AWS_BUCKET_NAME is set, otherwise memory (uploads lost on restart).
# STORAGE_DRIVER=
# Shared keys (normally in apps/.env). Omit the access keys to use an IAM role / instance profile.
# AWS_REGION=ap-south-1
# AWS_BUCKET_NAME=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# S3_UPLOAD_PREFIX=images

# ---- observability
# Enables GET /metrics (Prometheus text) behind "Authorization: Bearer <token>". 16+ chars; unset = no endpoint.
# METRICS_TOKEN=
